# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# preflight local order/receipt store
/.data/

# keys and credentials, in any form
*.key
*.p12
*.keystore
*keypair*.json
id_*
.secrets*
secrets/

# local AI tool and editor files
AGENTS.md
CLAUDE.md
.claude/
.cursor/
.codex/
.idea/
.vscode/

# planning notes, scratch and logs kept outside the product
*.plan.md
notes/
scratch/
*.log
